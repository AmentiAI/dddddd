# Copy to .env and fill in.

# Public URL of the site (no trailing slash).
BASE_URL=http://localhost:3000
PORT=3000

# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Secret for downloading the whitelist: <BASE_URL>/admin/export.csv?token=...
ADMIN_TOKEN=

# Whitelist spots. 0 = no cap.
WHITELIST_CAP=1750

# Neon / Postgres. When set, oaths are stored here instead of data/whitelist.json
DATABASE_URL=

# Local testing only. Never enable in production.
DEV_MODE=0
